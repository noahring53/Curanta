# ─────────────────────────────────────────────────────────────────────────────
# Curanta — environment variables
# Copy to .env (local) or set these in Railway → Variables (production).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase — REQUIRED for auth + persistence ───────────────────────────────
# Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key — REQUIRED so Stripe webhooks can update subscriptions.
# Project → Settings → API → service_role (secret). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic — REQUIRED for AI generation ───────────────────────────────────
# Without this the app runs in "mock mode" (placeholder copy, no real AI).
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (use exact model IDs from the Anthropic docs).
# Default is a fast, high-quality Sonnet model for all actions. Point
# ANTHROPIC_MODEL_LEAD at a stronger model to get the best quality on the
# flagship lead story while keeping the rest fast and cheap.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL_LEAD=<a-stronger-model-id>

# ── Research pipeline — the writing-quality core ─────────────────────────────
# Before writing, the model reads every source in full, extracts structured
# facts/quotes/figures, cross-references the sources against each other, and
# plans the piece. The writer then works from that dossier instead of truncated
# raw text, and the finished draft is fact-checked back against it.
#
# COST: this trades API calls for quality. A 4-source lead story goes from ~2
# calls to ~12 (research + editorial review). Extracted notes are cached by
# content hash for 6h and shared across every section using the same article,
# which absorbs most of the repeat cost within an issue.
#
# NOTE ON METERING: /api/ai still counts ONE generation per request regardless
# of how many model calls it makes. With the pipeline on, one "generation"
# against the monthly limit can be ~12 API calls. Revisit the limit/pricing
# before running this hot for paying users.
#
# ⚠ SHIPS OFF BY DEFAULT. The pipeline deploys inert so it can be switched on
# deliberately, after one real generation confirms the account and models behave
# as expected. Set RESEARCH_MODE=deep to activate; unset (or =off) is an instant
# rollback to the original single-call path. Neither direction needs a redeploy.
#
#   off       (default) original single-call behaviour
#   deep      full pipeline on long-form; fact extraction on short-form
#   long-form full pipeline on lead stories / prose sections only
# RESEARCH_MODE=off
# Model used for the research passes. Extraction is high-volume and mechanical,
# so a cheaper/faster model here is a reasonable cost lever; the writing pass
# still uses ANTHROPIC_MODEL / ANTHROPIC_MODEL_LEAD.
# ANTHROPIC_MODEL_RESEARCH=<a-cheaper-model-id>
# Hard cap on sources read per generation, and how many are read in parallel.
# RESEARCH_MAX_SOURCES=12
# RESEARCH_CONCURRENCY=4
# Set to "off" to skip the final fact-check pass (saves one call per lead story).
# RESEARCH_FACTCHECK=on
# Post-draft editorial review: a senior-editor critique of the draft, a revision
# limited to what the critique flagged, then fact verification re-run because
# revision is itself a place facts drift. This is what stops the pipeline
# shipping its first draft. Costs 2-3 calls on long-form. Set "off" to skip.
# RESEARCH_REVIEW=on
# Critique/revision is the most judgment-heavy step, so it defaults to
# ANTHROPIC_MODEL_LEAD. Point it somewhere stronger if you have it.
# ANTHROPIC_MODEL_REVIEW=<a-stronger-model-id>
#
# DEPTH IS ADAPTIVE. A deterministic complexity score (source count, source
# disagreements, timeline spread, hedged claims, weakly-sourced facts) decides
# what each story earns, so simple stories do not pay for deep machinery:
#   low     1 source or 2 that agree  → extract → outline → write → review
#   medium  several sources           → adds the editorial-judgment pass
#   high    sources contradict, or    → adds entity/knowledge-graph resolution
#           a tangled timeline           and a second review round
# Watch the [research] log line to see the tier and the signals behind it.
# How much of each scraped article is kept. The research pass reads all of it —
# the old 6500 cap truncated most real news stories mid-body.
# ARTICLE_TEXT_CHARS=20000

# ── App URL — used for Stripe redirect + webhooks ────────────────────────────
# Your deployed URL (no trailing slash). Defaults to the Railway URL if unset.
APP_URL=https://your-app.up.railway.app

# ── Stripe — REQUIRED for subscriptions / trials ─────────────────────────────
# Without these, new users cannot start a trial and AI generation stays gated.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# Price ID for the standard (single-publication) plan — Stripe → Products
STRIPE_PRICE_ID=price_...
# Price ID for the $99/mo multi-publication plan (optional)
STRIPE_MULTI_PRICE_ID=price_...
# Webhook signing secret — Stripe → Developers → Webhooks → your endpoint
# Endpoint URL: https://your-app.up.railway.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Beehiiv — OPTIONAL, for one-click publish ────────────────────────────────
# API key: app.beehiiv.com → Settings → API
BEEHIIV_API_KEY=your-beehiiv-api-key
# Publication ID: shown in the URL when you open your publication in Beehiiv
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Articles — single-source article drafting ────────────────────────────────
# The Articles tab scrapes ONE story (an RSS item or a pasted URL), strips it to
# title/publication/author/date/body, trims it to a word budget, and sends that
# plus your master prompt to the model. Everything here is a cost dial.
#
# Words of article body sent to the model. Higher = better context, higher bill.
# Clamped to 500–4000; the product spec's range is 1500–2500.
# ARTICLE_MAX_WORDS=2000
# How long a cleaned article stays cached (a re-paste inside this window is free).
# ARTICLE_CACHE_TTL_HOURS=24
# How many cleaned articles to keep in memory (LRU beyond this).
# ARTICLE_CACHE_MAX=300
# Below this word count we assume extraction failed (paywall, video page, JS-only
# render) and refuse rather than paying to draft from nothing.
# ARTICLE_MIN_WORDS=120
# Articles are long-form, so they follow ANTHROPIC_MODEL_LEAD unless pinned here.
# ANTHROPIC_MODEL_ARTICLE=<a-model-id>

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
